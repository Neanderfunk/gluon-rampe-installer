#!/bin/sh /etc/rc.common
#
# Gluon-RAMpe: Port 443 leitet auf http:// um.
#
# Firefox und Chrome setzen bei "192.168.1.1" + Enter oft selbst https://
# davor (adorfer, Windows 11, 15.10.2026). Ohne Dienst auf 443 sieht man dann
# nur eine Fehlerseite. Hier antwortet ein zweiter uhttpd per TLS mit einem
# beim Bau erzeugten, selbstsignierten Zertifikat (build.sh). Der Browser
# warnt einmal; nach "trotzdem fortfahren" leitet jede Adresse auf
# http://<Host>/ weiter, wo Gluons Config-Mode laeuft (S50uhttpd, Port 80).
# Ohne TLS-Bibliothek oder Zertifikat startet nichts.

START=51

USE_PROCD=1

D=/lib/gluon/rampe-https

start_service() {
	[ -e /lib/libustream-ssl.so ] || return 0
	[ -s "$D/cert.pem" ] && [ -s "$D/key.pem" ] || return 0
	procd_open_instance
	procd_set_param respawn
	procd_set_param command /usr/sbin/uhttpd -f -h "$D/www" -E /index.html \
		-C "$D/cert.pem" -K "$D/key.pem" -s 0.0.0.0:443
	procd_close_instance
}
